<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
  </style>

  <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:background">@color/background_dark</item>
    <item name="android:statusBarColor">@color/background_dark</item>
    <item name="android:navigationBarColor">@color/background_dark</item>
  </style>

  <!--
    The launch theme, for every API level. androidx.core:core-splashscreen
    backports these attributes to API 21, so there is one definition rather than
    a v31 fork that leaves older devices with no splash at all.

    `windowDisablePreview` used to be set here, which suppressed the launch
    window outright — that is why nothing appeared on API 24-30.
  -->
  <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/background_dark</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/nightshelf_splash_mark</item>
    <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
  </style>

  <style name="MediaPlayerWidgetTheme" parent="Theme.AppCompat.DayNight">
    <item name="android:colorBackground">@color/background_dark</item>
    <item name="android:colorAccent">@color/nightshelf_surface</item>
    <item name="android:textColor">@color/nightshelf_text</item>
  </style>

  <style name="Widget.Android.AppWidget.Container" parent="android:Widget">
    <item name="android:id">@android:id/background</item>
    <item name="android:background">?android:attr/colorBackground</item>
  </style>

  <style name="Widget.Android.AppWidget.InnerView" parent="android:Widget">
<!--    <item name="android:background">?android:attr/colorBackground</item>-->
<!--    <item name="android:textColor">?android:attr/textColorPrimary</item>-->
    <item name="android:padding">0dp</item>
  </style>
</resources>
