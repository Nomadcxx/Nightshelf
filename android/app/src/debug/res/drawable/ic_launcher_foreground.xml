    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
  <group
      android:pivotX="256"
      android:pivotY="289"
      android:scaleX="0.78"
      android:scaleY="0.78"
      android:translateY="-33">
